 	opts := []headless_browser.Option{
 		headless_browser.WithHeadless(headless),
-		// 用内置浏览器的默认配置，不强制 UA。
-		headless_browser.WithFingerprint(""), // 空 = 按运行 OS 自动：Linux→windows，mac→macos
 		headless_browser.WithStealthJS(false),
