# 复制为 .env 后填写。所有凭据只从环境变量读取，禁止写入数据库或代码。
# 布尔值统一使用 true / false。

# ---------- LLM ----------
# 后端开关：anthropic（默认，直连 Claude Messages API）| dsh（本机 deepseek-harness
# Agent runtime 子进程，需要 `uv sync --extra dsh`，见 docs/OPS.md 第 7.5 节）
SW_LLM_BACKEND=anthropic
# Anthropic API Key，格式 sk-ant-...
# 留空时 /dev/run_wechat_pipeline 会降级到 ScriptedLLM 预置内容（非真实生成）
ANTHROPIC_API_KEY=
# 默认模型（生成 / 选题 / 审核 Agent 共用）。历史别名 ANTHROPIC_MODEL 仍可用
LLM_MODEL=claude-opus-5
# 思考深度与输出预算档位：low | medium | high | xhigh | max
LLM_EFFORT=medium
# **兜底**输出上限：只作用于没有显式声明 max_tokens 的调用。生成链各调用点的预算
# 见 generation/output_budget.py 的分档表，不吃这个值。
# 别改回 4096：默认模型是 reasoning 模型，思考与正文共用输出预算，
# 4096 会被思考单独吃光（2026-08-17 生产事故）
LLM_MAX_TOKENS=8192
# 长输出（文章正文，走流式）上限。与分档表的"大输出档"同值——dsh 后端按
# (思考档, 输出上限) 分桶起 runtime 子进程，多一个取值就多一个常驻进程
LLM_ARTICLE_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=600

# ---------- LLM · deepseek-harness 后端（只在 SW_LLM_BACKEND=dsh 时生效）----------
# ⚠️ 这一组一律以 SW_DSH_ 打头，**千万别写成 DSH_**。dsh 的产品 CLI 启动时会逐行读
# 项目 .env，凡是名字落在 DSH_ / XDG_ / DYLD_ / BASH_FUNC_ 前缀上的一律抛错拒绝启动
# （供应链防护，没有开关可关）。这里留一行 DSH_XXX=，对话台（sw-harness）在本仓库目录下
# 就起不来，报 `dsh: …/.env sets "DSH_PROVIDER", which only the launching environment may set`。
# 旧的 DSH_* 名字仍然作为回退别名生效，但会打弃用日志、preflight 报 WARN，请尽快改。
#
# provider 路由名，必须在 configs/dsh/cordis.yml 里注册过（四条，与该文件 dsh-llm-pi-ai 段
# 的 providers 子键一一对应）：
#   deepseek-official（DEEPSEEK_API_KEY）| deepseek（DEEPSEEK_API_KEY）
#   | gateway（SW_DSH_GATEWAY_API_KEY）| anthropic（ANTHROPIC_API_KEY）
# 走私有网关（Sub2API 等）时必须用 `deepseek` 路由：它与 deepseek-official 同凭据、同端点，
# 区别在路由名让 pi-ai 认出 DeepSeek 方言（system 角色而非 developer、max_tokens 字段、
# reasoning_content 回填）；deepseek-official 只适合真官方端点，挂私有网关会被当成标准
# OpenAI 端点发 developer 角色而 400。网关 baseURL 记得带 /v1（Sub2API 裸路径是网页）。
SW_DSH_PROVIDER=deepseek
SW_DSH_MODEL=deepseek-v4-flash
# 按 purpose 分档路由模型；关闭或 purpose 未登记时仍回落 SW_DSH_MODEL / LLM_EFFORT。
# complex 档走 SOL @ xhigh；medium 与 low 两档都走 LUNA @ max（映射表见
# generation/model_routing.py 的 tier_models / COMPLEXITY_EFFORT）。
# 迁移（本次变更）：SW_DSH_TERRA_MODEL 已**移除**——medium 档不再有独立模型旋钮，
# 改由 SW_DSH_LUNA_MODEL 一并决定。旧 .env 里若还留着这一行，它不会报错，
# 但已经是**静默无效**的键（core/config.py 的 Settings 是 extra="ignore"），请删掉。
SW_DSH_MODEL_ROUTING=false
SW_DSH_SOL_MODEL=gpt-5.6-sol
SW_DSH_LUNA_MODEL=gpt-5.6-luna
# 受限 Cordis 组合（零工具红线所在）。相对项目根解析
SW_DSH_CORDIS_PATH=configs/dsh/cordis.yml
# JSONL 会话日志目录（含完整 prompt 与回复，按内部资料对待，不自动清理）
SW_DSH_SESSION_ROOT=data/dsh_sessions
# 0 = 沿用上面的 LLM_MAX_TOKENS / LLM_ARTICLE_MAX_TOKENS；> 0 则再压一道统一上限
SW_DSH_MAX_TOKENS=0
# runtime 子进程按 (思考档, 输出上限) 分桶，池子上限
SW_DSH_MAX_LIVE_RUNTIMES=4
# DeepSeek 官方路由：DEEPSEEK_API_KEY 必填，端点可覆盖
DEEPSEEK_API_KEY=
SW_DSH_DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI 兼容自建网关路由（不用就整段留空）
SW_DSH_GATEWAY_API_KEY=
SW_DSH_GATEWAY_BASE_URL=
SW_DSH_GATEWAY_MODEL=

# ---------- 生图配图（P11，generation/imagegen.py）----------
# OpenAI Images API 兼容端点。留空 = 复用上面 SW_DSH_DEEPSEEK_BASE_URL 那条网关
# （同一个网关，只是换一把 key）
SW_IMAGEGEN_BASE_URL=
# 生图**专用** key，与聊天 key 分开——网关按 key 分组授权，图像生成是单独的开关。
# 留空则回落到 DEEPSEEK_API_KEY，多半没有图像权限，首调会如实报 permission_error
SW_IMAGEGEN_API_KEY=
# 默认模型。代码里的默认值就是 gpt-image-2，这行只是让它显式可见；
# gpt-image-1 / gpt-image-1.5 作为可配回退
SW_IMAGEGEN_MODEL=gpt-image-2
# auto（默认）= 启动不探测，首调失败就在本进程内熔断，不反复烧钱试；
# true = 强制启用；false = 完全关掉（测试与 e2e 用这个）
SW_IMAGEGEN_ENABLED=auto
# 生图比文字慢得多，单独给更长的超时
SW_IMAGEGEN_TIMEOUT_SECONDS=180
# 门禁自检是否**真发一张图**探权限。默认关：preflight 在 CI 和每次开工都会跑，
# 每次烧一张图不划算。要探就临时置 true 跑一次
SW_PREFLIGHT_IMAGEGEN=false
SW_DSH_GATEWAY_CONTEXT_WINDOW=131072
SW_DSH_GATEWAY_MAX_TOKENS=8192
# runtime 的进程级 persona（per-call system 会另行拼进用户消息）
SW_DSH_PERSONA=

# ---------- 选题采集 ----------
# newsnow 自部署或公开实例地址，如 http://localhost:4444
# 【默认留空】不配则该数据源不可用——刻意不给默认值，避免默认去打别人的服务器
NEWSNOW_BASE_URL=
# 逗号分隔的榜单 id（已实测有效：weibo/zhihu/baidu/toutiao，完整 66 个见上游 sources.json）
NEWSNOW_SOURCES=weibo,zhihu,baidu,toutiao
# douyin-hot-hub 归档仓库。注意 JSON 在 raw/YYYY-MM-DD/ 下，archives/ 是 Markdown
DOUYIN_HOT_HUB_BASE_URL=https://raw.githubusercontent.com/lonnyzhang423/douyin-hot-hub/main
SOURCING_TIMEOUT_SECONDS=15

# TrendRadar sidecar（GPL-3.0，P4）。注意它**没有 REST API**：8080 上是
# `python -m http.server` 挂出来的 output/ 目录，core 读它产出的
# output/news/{YYYY-MM-DD}.db。详见 sidecars/trendradar/README.md
# 【默认留空】不配则该数据源不可用。core 在容器里时写 http://trendradar:8080
TRENDRADAR_BASE_URL=
# db = 读 SQLite（路径确定，推荐）；txt = 读最新文本快照；auto = 先 db 后 txt
TRENDRADAR_MODE=auto
# 只在 docker compose --profile sourcing 里用到
TRENDRADAR_CRON=*/30 * * * *
TRENDRADAR_HOST_PORT=8081

# ---------- 审核词库 ----------
# konsheng/Sensitive-lexicon 词表下载目录（data/ 已在 .gitignore，词库不进版本库）
# 首次使用前跑：uv run python scripts/fetch_lexicon.py
LEXICON_DIR=data/lexicon

# ---------- 公众号正文渲染（generation/wechat_render.py） ----------
# wenyan 主题：default/orangeheart/rainbow/lapis/pie/maize/purple/phycat
WENYAN_THEME=default
WENYAN_NPM_SPEC=@wenyan-md/cli
# 调用 wenyan 的可执行文件；缺 Node 时 body_html 留空，内容仍入库等人工处理。
# P4 归并：渲染侧（generation/wechat_render.py）与发布侧
# （publishers/wechat_mp/wenyan_backend.py）此前各读一半配置，现在统一 WENYAN_* 前缀。
# 历史别名 NODE_BIN 仍然生效，但 preflight 会报 WARN 提示改名
WENYAN_NODE_BIN=npx
WENYAN_TIMEOUT_SECONDS=120

# ---------- 微信公众号 ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 【双确认闸门 2/3】账号是否已认证：认证号才有 freepublish 权限；未认证只能落草稿箱
# 必须与公众号后台的实际认证状态一致，否则发布时报 errcode=48001
WECHAT_CERTIFIED=false
# 【双确认闸门 1/3】服务端自动发布总开关。false = 一律只落草稿箱（最安全的默认值）
# 第 3 道闸门是审核 UI 逐条写入的 platform_extra.confirm_publish，无法在这里配置
WECHAT_AUTO_PUBLISH=false
# 发布后端：api = 官方 HTTP API；wenyan = @wenyan-md/cli 子进程直传草稿箱（需要 Node）
WECHAT_BACKEND=api
# 官方 API 基址（自建中转 / 联调时覆盖）
WECHAT_API_BASE=https://api.weixin.qq.com
# 正文里相对图片路径的解析根目录；留空 = 进程当前目录
WECHAT_MEDIA_BASE_DIR=
# freepublish 任务轮询间隔 / 超时（秒）
WECHAT_PUBLISH_POLL_INTERVAL=3.0
WECHAT_PUBLISH_POLL_TIMEOUT=120.0
# 可选：wenyan Server 中转地址（绕开固定出口 IP 白名单，errcode 40164）
WENYAN_SERVER_URL=
# wenyan Server 模式的 API key 文件路径（凭据不入代码、不入库）
WENYAN_API_KEY_FILE=

# ---------- 视频素材源（MoneyPrinterTurbo 必需） ----------
# 注意：MPT 真正读的是 sidecars/mpt/config.toml 里的 pexels_api_keys / pixabay_api_keys。
# 这里这两个只被 scripts/preflight.py 用来验 key 本身是否有效。两边要同步，
# 否则会出现"key 明明配了却还是 materials 阶段失败"。见 docs/OPS.md 4.5.1
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- sidecar 端点 ----------
# MoneyPrinterTurbo HTTP API。core 也跑在容器里时写 http://mpt:8080
MPT_BASE_URL=http://localhost:8080

# ---------- 视频渲染（MoneyPrinterTurbo，P3） ----------
# 上游默认不鉴权，留空即可；部署方自行打开 verify_token 时才填（走 x-api-key 头）
MPT_API_KEY=
MPT_TIMEOUT_SECONDS=30.0
# 成片几十 MB，下载单独给更长的超时
MPT_DOWNLOAD_TIMEOUT_SECONDS=600.0
# 生成链等待单个渲染任务的上限。**超时不算失败**：RenderJob 留着，
# 由 core.scheduler.tick_render_jobs 继续跟，渲染完自动把成片补挂回内容包
MPT_RENDER_TIMEOUT_SECONDS=1800.0
MPT_POLL_INTERVAL_SECONDS=5.0
# 素材源：pexels / pixabay / coverr（key 配在 sidecar 的 config.toml 里）
MPT_VIDEO_SOURCE=pexels
# 留空 = 用 sidecar 侧默认中文音色（edge-tts）
MPT_VOICE_NAME=
# 字幕位置：top / bottom / center / custom。抖音静音播放占多数，字幕必须开
MPT_SUBTITLE_POSITION=bottom
# 单个素材片段时长（秒），越短剪辑感越强
MPT_CLIP_DURATION=3
MPT_BGM_TYPE=random
# XHS-Downloader（GPL，独立进程）
# 宿主机侧端口。compose 里**只绑 127.0.0.1**（它没有任何鉴权，见 docker-compose.yml 的注释），
# 改这个就要同步改下面 BASE_URL 里的端口，两处必须一致
XHS_DOWNLOADER_HOST_PORT=5556
XHS_DOWNLOADER_BASE_URL=http://localhost:5556
# 小红书发布 sidecar：一账号一容器，格式 account_id=http://host:port，逗号分隔。
#
# **正确值按 core 跑在哪儿分两种，照抄错的那种连不通。** 这一条和上面 MPT /
# XHS-Downloader / TrendRadar 三条不一样：那三条在 docker-compose.yml 的 core
# `environment:` 里各有一行容器形态的值，而 compose 的 environment 优先于 env_file，
# 所以 .env 里写 localhost 也会被盖掉；**XHS_MCP_ENDPOINTS 在 compose 里没有对应行**，
# .env 里写什么容器里读到的就是什么，写错没人兜底。
#
# (1) core 跑在**宿主机**上（uvicorn）——本文件其余各项默认的形态：用**宿主机端口**，
#     从 18060 起逐个 +1（compose 只绑 127.0.0.1，本机连得上，同网段连不上）。
XHS_MCP_ENDPOINTS=xhs-demo-01=http://localhost:18060,xhs-demo-02=http://localhost:18061
# (2) core 跑在**容器**里（docker compose 起 sw-core）——用 **compose 服务名 + 容器端口**，
#     每个账号都是 **18060**（容器端口全都是 18060，只有宿主机端口才逐个 +1）。服务名由
#     scripts/gen_xhs_sidecars.py 的 service_name_for() 生成，与 accounts.yaml 的账号 id 同名；
#     sidecar 与 core 同在 social_workflow 网络，走容器网络、不经宿主机端口发布。
#     **仅当 sidecar 由 docker-compose.xhs.yml 起时成立**（SW_SIDECAR_DRIVER=none，默认值）。
#     用 (1) 的 localhost 形态填进容器化 core，localhost 指的是 core 自己，必然连不通。
# XHS_MCP_ENDPOINTS=xhs-demo-01=http://xhs-demo-01:18060,xhs-demo-02=http://xhs-demo-02:18060
#
# 没有第三种：SW_SIDECAR_DRIVER=docker 起的容器**不接** social_workflow 网络
# （core/sidecars.py 的 docker run 不带 --network），容器化的 core 够不着它；
# 而该驱动本身也要求 core 跑在宿主机上（镜像里刻意没装 docker CLI）。见 docs/RISKS.md §15.7。
# 抖音发布器（宿主机常驻有头进程，不入 Docker）；历史别名 DOUYIN_AGENT_BASE_URL 仍可用
# core 也跑在容器里时要写 http://host.docker.internal:8710
DOUYIN_SERVICE_URL=http://127.0.0.1:8710

# ---------- 小红书 sidecar 生命周期（P10，core/sidecars.py） ----------
# 谁来起停容器：
#   none   = core 不接管（默认）。账号照样能建、能出稿，账号页如实显示"sidecar 未接入"；
#            容器自己用 docker-compose.xhs.yml 管。本机开发、CI、Playwright 全用它
#   docker = 工作台上的「启动 / 停止 / 重建」直接调宿主机 docker CLI（生产用这个）
SW_SIDECAR_DRIVER=none
# sidecar 镜像。上游 xpzouying/xiaohongshu-mcp **只发 amd64**；aarch64 服务器要先本地构建：
#   git clone --depth 1 --branch v2.5.0 https://github.com/xpzouying/xiaohongshu-mcp
#   cd xiaohongshu-mcp && docker build -t xiaohongshu-mcp:v2.5.0-arm64 .
# 然后把镜像名填这里
SW_XHS_MCP_IMAGE=xpzouying/xiaohongshu-mcp:v2.5.0
# docker 可执行文件与单次调用超时（拉镜像那次会久）
SW_DOCKER_BIN=docker
SW_DOCKER_TIMEOUT_SECONDS=120
# 新账号自动分配宿主机端口的起点，逐个 +1 找空闲（只绑 127.0.0.1，不对外暴露）
SW_SIDECAR_BASE_PORT=18060

# ---------- 小红书（xiaohongshu-mcp sidecar，P2） ----------
# 每个 sidecar 一个 Bearer token。compose 从 XHS_TOKEN_<账号大写> 取值传给容器的 AUTH_TOKEN，
# core 侧要在 XHS_MCP_TOKENS 里填同样的值才带得上 Authorization 头（两处必须一致）。
# 生成命令：openssl rand -hex 24
XHS_TOKEN_XHS_DEMO_01=
XHS_MCP_TOKENS=
# 所有 sidecar 共用一个 token 时改用这个（优先级低于 XHS_MCP_TOKENS）
XHS_AUTH_TOKEN=
# accounts.yaml / DB 里 daily_limit 为 0 时的兜底。计划口径：日 <= 50，测试期 <= 10
XHS_DAILY_LIMIT=50
# 对账与指标扫描主页最近多少条笔记
XHS_RECONCILE_NOTES=20
# 素材目录映射：宿主机路径 -> 容器内路径（compose 里只读挂载）。
# 置空表示 sidecar 与 core 共享文件系统（如 macOS 上直接跑二进制），路径原样透传
XHS_MEDIA_HOST_DIR=data/media
XHS_MEDIA_CONTAINER_DIR=/app/images
# 浏览器自动化很慢：普通接口 30s，发布（传图 + 等跳转）单独给 300s
XHS_TIMEOUT_SECONDS=30
XHS_PUBLISH_TIMEOUT_SECONDS=300
# 登录态巡检间隔（分钟）。掉线即挂起该账号排期并通知去扫码
XHS_LOGIN_HEALTH_INTERVAL_MINUTES=10

# ---------- 抖音（宿主机 Patchright 上传器，P3） ----------
# 启动：uv sync --extra douyin && uv run python -m publishers.douyin serve --port 8710
# 必须跑在有图形界面的宿主机上（抖音检测 headless），**不进 Docker**。
# 浏览器 channel：优先用系统 Chrome；起不来自动回退 patchright 自带 chromium
DOUYIN_BROWSER_CHANNEL=chrome
# 一号一 profile 的根目录（.gitignore 已排除 profiles/）。禁止跨账号复用
DOUYIN_PROFILE_ROOT=profiles/douyin
# 每步失败的截图落点（选择器失配时唯一能定位问题的证据）
DOUYIN_SCREENSHOT_DIR=data/douyin/screenshots
# 可选：选择器覆盖表（JSON）。平台改版时改这个文件即可，不用改代码
DOUYIN_SELECTORS_FILE=
# accounts.yaml / DB 里 daily_limit 为 0 时的兜底。docs/POLICY.md 口径：抖音日 <= 2
DOUYIN_DAILY_LIMIT=2
# 两次发布最小间隔（分钟）。比全局 SW_MIN_PUBLISH_INTERVAL_SECONDS 更保守
DOUYIN_MIN_INTERVAL_MINUTES=30
# 对账 / 指标扫描内容管理页最近多少条作品；"多久以内算这次发的"
DOUYIN_RECENT_POSTS=20
DOUYIN_RECONCILE_WINDOW_HOURS=24
# 普通接口 30s；发布（传成片 + 平台转码 + 等跳转）单独给 1200s
DOUYIN_TIMEOUT_SECONDS=30
DOUYIN_PUBLISH_TIMEOUT_SECONDS=1200
# 素材目录映射：core 侧路径 -> 宿主机路径。core 在容器里时才需要，两个都留空 = 同机
DOUYIN_MEDIA_LOCAL_DIR=
DOUYIN_MEDIA_HOST_DIR=
# 登录巡检间隔（分钟）。每次巡检都会真开浏览器，比小红书贵得多
DOUYIN_LOGIN_HEALTH_INTERVAL_MINUTES=30

# ---------- 通知 ----------
# 飞书自定义机器人 webhook；留空则退化为日志通知
FEISHU_WEBHOOK=
# 同一 (account_id, event_kind) 在这么多分钟内只推一次，防止"号掉线了"这类会被定时任务
# 反复触发的通知刷屏（人第一反应是把通知静音，那等于把通道整个废掉）
SW_NOTIFY_THROTTLE_MINUTES=120
# 通知里 /review/xxx 这类链接的对外基址，如 https://ops.example.com。留空只给相对路径——
# Telegram 里点不动，但不会拼出一个错的域名
SW_PUBLIC_BASE_URL=

# ---------- Telegram 提醒渠道 + 发布前人工确认（P12）----------
# 凭据只走这里，不入库、不进前端、不写日志明文。建 bot / 拿 chat_id 的步骤见 docs/OPS.md 7.6 节
# @BotFather /newbot 拿到的 token
TELEGRAM_BOT_TOKEN=
# 目标会话 id。跑 `uv run python -m core.telegram setup` 抓；没有它就拒绝发送
TELEGRAM_CHAT_ID=
# 群聊里额外允许点确认按钮的 user id（逗号分隔）。留空 = 只认 TELEGRAM_CHAT_ID 本人（私聊场景）
SW_TELEGRAM_ALLOWED_USER_IDS=
# 通道总开关。false 时连 long polling 线程都不起（e2e / CI 的默认形态，见 ui/e2e/serve.sh）
SW_TELEGRAM_ENABLED=true
SW_TELEGRAM_API_BASE=https://api.telegram.org
SW_TELEGRAM_TIMEOUT_SECONDS=15
# long polling 的 timeout 参数：服务端 hold 住这么久没消息才返回空
SW_TELEGRAM_POLL_TIMEOUT_SECONDS=30
# getUpdates 游标落盘位置，进程重启后不重复消费已处理的回调
SW_TELEGRAM_STATE_FILE=data/telegram_state.json
# callback_data 的 HMAC 签名密钥。留空按 SW_UI_TOKEN → bot token 顺序回落；
# 三个都空则不发带按钮的卡片（没有密钥就没法验证按钮没被伪造，宁可不发）
SW_TELEGRAM_SIGNING_SECRET=
# 推了确认卡这么多小时没人点就自动驳回、释放排期槽位（也可在 accounts.yaml 按账号覆盖）
SW_CONFIRM_TTL_HOURS=24
# 槽位前这么多分钟仍未确认，补推一次提醒（只补一次）
SW_CONFIRM_REMIND_MINUTES=30

# ---------- 成本闸门 ----------
# 每日 Claude token 上限
DAILY_TOKEN_BUDGET=2000000
# 每日视频渲染秒数上限
DAILY_RENDER_SECONDS_BUDGET=3600
# 每日生图**张数**上限（P11）。刻意不按 token 计：生图有独立的 key 与计价口径，
# 混进 tokens 会让写稿的预算被配图悄悄吃掉。SW_DAILY_IMAGE_BUDGET 是等价别名
DAILY_IMAGE_BUDGET=40

# ---------- 运行时 ----------
SW_DATABASE_URL=sqlite:///./data/social_workflow.db
SW_ENV=dev
# true 时把三个平台全部覆盖成 FakePublisher（本地联调）。
# P1 起公众号已有真实实现，要跑真实公众号必须改为 false，否则会被 Fake 顶掉
SW_USE_FAKE_PUBLISHERS=true
# 单账号两次发布之间的最小间隔（秒）
SW_MIN_PUBLISH_INTERVAL_SECONDS=900
# 发布最大重试次数，超过进入死信
SW_MAX_PUBLISH_ATTEMPTS=3
# 启动时把 accounts.yaml 同步进 DB（幂等，不覆盖运行时 status）。
# 关掉就必须手动 `uv run python -m core.accounts sync`，否则调度器看不见台账里的账号
SW_SYNC_ACCOUNTS_ON_START=true
# 账号台账路径。留空 = 仓库根的 accounts.yaml。
# 工作台的「添加账号」会**回写**这个文件（写完再同步进 DB，所以 check 永远是通过的），
# 容器部署时记得把它挂成持久卷，否则重建容器台账就没了
SW_ACCOUNTS_FILE=
# 工作台 JSON API（/api/v1）的访问 token。留空 = 不鉴权（本机 ops 工具的默认形态）；
# 填了之后 /api/v1/* 一律要求 `Authorization: Bearer <token>`，见 docs/WORKBENCH_API.md。
# 现有的 Jinja2 页面（/review、/accounts、/stats）与 /health 不受影响
SW_UI_TOKEN=

# ---------- 调度（P4）----------
# 发布时段窗口（Account.extra['publish_windows']）默认用的时区
SW_TIMEZONE=Asia/Shanghai
# 各 tick 的间隔。scheduled_publish 与 render_jobs 固定每分钟，不可配
SW_SOURCING_INTERVAL_HOURS=6
SW_GENERATE_INTERVAL_MINUTES=30
SW_RETRY_SWEEP_INTERVAL_MINUTES=5
# 单次 tick 的批量上限
SW_PUBLISH_BATCH_SIZE=20
SW_GENERATE_MAX_PER_TICK=3
# 关掉后 tick_generate 只统计不生成（POST /dev/tick/generate 仍可手动触发）
SW_GENERATE_ENABLED=true
# 自动生成时是否出封面 / 卡片。无 Playwright / Node 的机器上置 false
SW_GENERATE_MAKE_MEDIA=true
# 抖音自动生成默认不真渲染：一条片子几分钟起步且烧素材源配额
SW_GENERATE_SKIP_RENDER=true
# 自动出稿每条配几张生图（P11）。公众号题图与抖音封面只取 1 张；
# 0 = 自动出稿一律不配图（工作台手动出稿仍可在弹层里单独打开）
SW_GENERATE_ILLUSTRATIONS=2
# 出稿时刻的随机抖动（秒，±，P12）。每天整点同一秒出稿太机器；0 = 不抖
SW_GENERATE_JITTER_SECONDS=600
# 重试退避：base * 2^(attempts-1)，封顶 max
SW_RETRY_BACKOFF_BASE_SECONDS=300
SW_RETRY_BACKOFF_MAX_SECONDS=14400
# 卡在 retrying 超过这个时长直接进死信（NeedsRelogin 长期没人处理的兜底）
SW_RETRY_MAX_AGE_HOURS=48

# ---------- 复盘 Agent（P4）----------
INSIGHTS_ENABLED=true
# 每个账号多久复盘一次（小时）
INSIGHTS_INTERVAL_HOURS=24
# insights.md 里保留最近几条
INSIGHTS_KEEP=6
# 7 天内已发少于这么多条就不复盘（样本太小，结论全是噪声）
INSIGHTS_MIN_POSTS=3
