{
  "name": "social-workflow-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "social_workflow 运营工作台前端（Next.js 静态导出，企业控制台设计语言）",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
