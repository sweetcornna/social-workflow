{
  "name": "sw-workbench-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "social_workflow 工作台桌面壳（Electron 薄壳：内嵌静态服务 + core 反向代理）",
  "license": "UNLICENSED",
  "author": "Cornna",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
